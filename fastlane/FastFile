# fastlane/Fastfile — CI-only lanes consumed by mifos-x-actionhub actions.
#
# The mifos-x-actionhub-build-ios-app action runs `bundle exec fastlane ios build_ios`
# from the repo root and expects fastlane/ to exist here.
#
# Deployment lanes live in deployment/Fastfile. Due to Fastlane's nested-import path
# resolution limitation (fastlane/fastlane#20974), they are invoked via a dedicated
# script: `bash scripts/sync-play-listing.sh` (Android Play Store listing sync).
# See deployment/BOOTSTRAP.md for all available lanes and their invocation commands.

default_platform(:ios)

platform :ios do
  desc "Build unsigned debug iOS app for PR checks (no signing, no archive)"
  lane :build_ios do
    cocoapods(
      podfile:                  "cmp-ios/Podfile",
      try_repo_update_on_error: true
    )

    # kmp-product-flavors adoption replaced the single `iosApp` scheme with
    # per-variant schemes (demoDebug / demoRelease / prodDebug / prodRelease).
    # The PR check just needs one debug variant to compile — use prodDebug.
    build_ios_app(
      scheme:            "prodDebug",
      workspace:         "cmp-ios/iosApp.xcworkspace",
      output_name:       "iosApp.ipa",
      output_directory:  "cmp-ios/build",
      skip_codesigning:  true,
      skip_archive:      true
    )
  end
end
