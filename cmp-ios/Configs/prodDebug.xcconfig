// Generated by com.mobilebytelabs.kmp-product-flavors — DO NOT EDIT.
// Re-generate: ./gradlew generateIosFlavorXcconfigs
//
// This file is the Xcode build configuration's base config (wired in
// project.pbxproj). Xcode does not expand $(CONFIGURATION) in an xcconfig
// #include, so each build config points at its own file directly.

KMPF_VARIANT = prodDebug
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
DEVELOPMENT_TEAM = $(TEAM_ID)

// CocoaPods — per-configuration link/framework settings. Optional (#include?)
// so a fresh clone builds before `pod install` runs (Pods/ is gitignored and
// regenerated by CI). CocoaPods lowercases the configuration name.
#include? "../Pods/Target Support Files/Pods-iosApp/Pods-iosApp.proddebug.xcconfig"
