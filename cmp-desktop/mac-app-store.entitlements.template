<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store entitlements TEMPLATE. syncForkConfig substitutes {{APPLE_TEAM_ID}} and
  {{APPLE_APP_IDENTIFIER}} from app-profile (apple.team_id + identity.app_id) into the shipped
  cmp-desktop/mac-app-store.entitlements — do NOT hand-edit the generated .entitlements file.
-->
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Network access for API clients -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read-only access to user's files (for export features) -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- Application identifier required by TestFlight / Mac App Store provisioning profile -->
    <key>com.apple.application-identifier</key>
    <string>{{APPLE_APP_IDENTIFIER}}</string>
    <!-- Team identifier required alongside application-identifier -->
    <key>com.apple.developer.team-identifier</key>
    <string>{{APPLE_TEAM_ID}}</string>
</dict>
</plist>
